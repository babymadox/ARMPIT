NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by webhooks and sync jobs that act without a user session. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that verifies inbound provider webhooks (Telegram, WhatsApp, Gmail push).
WEBHOOK_SECRET=
# Cron endpoints (/api/cron/*) require this as a Bearer token.
CRON_SECRET=
# AI agent
ANTHROPIC_API_KEY=
# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
